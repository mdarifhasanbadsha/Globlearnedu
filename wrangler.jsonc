{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "globlearnedu",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Non-secret configuration only. Secrets (DATABASE_URL, API keys, tokens)
  // are NEVER committed: set them with `wrangler secret put <NAME>` on the
  // "globlearnedu" Worker, which is what this pipeline deploys to.
  //
  // Declaring these here keeps them stable across deploys; dashboard-only
  // variables can be dropped because wrangler deploy treats this file as
  // the source of truth.
  "vars": {
    "BUSINESS_ID": "18a043a9-0160-4e2f-800a-413f6ff8de6f",
    "META_VERIFY_TOKEN": "gl_edu_wh_2027",
    "META_PAGE_ID": "110755801517914",
    "META_GRAPH_VERSION": "v26.0",
    "BUSINESS_TIMEZONE": "Asia/Dhaka"
  }
}
